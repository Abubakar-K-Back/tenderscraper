# Facebook Page API
FB_PAGE_ID=your_page_id_here
FB_PAGE_ACCESS_TOKEN=your_long_lived_page_access_token_here

# Pages per filter combination (newest first on page 1).
PAGES_TO_SCRAPE=2

# PPRA filters
TENDER_TYPE=1
CITIES=Islamabad,Lahore,Karachi

# Digest niches (post order = largest niche first that day; this list is tie-break only)
ENABLED_NICHES=civil_works,health,ict

MAX_DIGEST_POSTS_PER_DAY=3
# Cards on the digest image
DIGEST_MAX_ITEMS=4
# Max tenders listed in the Facebook caption
DIGEST_CAPTION_MAX=10

POST_DELAY_SECONDS=3600
RUN_TIME=09:00

# Facebook Page API
FB_PAGE_ID=your_page_id_here
FB_PAGE_ACCESS_TOKEN=your_long_lived_page_access_token_here

# How many listing pages to scrape each run (50 tenders per page).
# New tenders appear on page 1 first, so 1-2 is usually enough for a daily run.
PAGES_TO_SCRAPE=2

# Safety cap: max number of new tenders to post to Facebook in a single run.
MAX_POSTS_PER_RUN=15

# Seconds to wait between consecutive Facebook posts (avoid rate limiting).
POST_DELAY_SECONDS=8

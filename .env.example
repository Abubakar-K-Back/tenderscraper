# Facebook Page API
FB_PAGE_ID=your_page_id_here
FB_PAGE_ACCESS_TOKEN=your_long_lived_page_access_token_here

# Pages per filter combination (newest first on page 1).
PAGES_TO_SCRAPE=2

# PPRA filters
# tender_type=1 → Tender Notice only
TENDER_TYPE=1

# Cities (comma-separated names — PPRA uses city name strings)
CITIES=Islamabad,Lahore,Karachi

# Digest niches = sectors: civil_works, health, ict
ENABLED_NICHES=civil_works,health,ict

MAX_DIGEST_POSTS_PER_DAY=3
DIGEST_MAX_ITEMS=8
SPOTLIGHT_ENABLED=true

# Seconds between Facebook posts (digests + spotlight)
POST_DELAY_SECONDS=3600

# Daily run time for Docker scheduler (HH:MM, container-local time)
RUN_TIME=09:00
